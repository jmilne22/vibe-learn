{
  "name": "vibe-learn",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "AI coding mentor toolkit, on-demand STE100 project generator, and curated engineering tracks.",
  "author": "James Milne",
  "license": "MIT",
  "bin": {
    "vibe-learn": "./build/cli/index.js"
  },
  "files": [
    "build/cli",
    "build/content/catalog.json",
    "skills"
  ],
  "scripts": {
    "dev": "npm run content && vite",
    "content": "tsx src/content/compile.ts",
    "validate:content": "tsx src/content/compile.ts --check",
    "build:cli": "tsx scripts/build-cli.ts",
    "build": "npm run content && vite build && npm run build:cli",
    "preview": "npm run build && vite preview --host 127.0.0.1 --port 5173 --strictPort",
    "cli": "tsx src/cli/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts/*.ts tests/v2",
    "test": "vitest run",
    "test:ui": "playwright test",
    "verify": "npm run typecheck && npm run lint && npm run validate:content && npm test && npm run build && npm run test:ui"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@tanstack/react-query": "^5.90.0",
    "cheerio": "^1.1.2",
    "highlight.js": "^11.11.1",
    "js-yaml": "^4.1.0",
    "marked": "^15.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "sanitize-html": "^2.17.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.58.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/sanitize-html": "^2.16.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.0",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=24"
  }
}
